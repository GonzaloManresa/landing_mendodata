---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Problems from '../components/home/Problems.astro';
import Solutions from '../components/home/Solutions.astro';
import FeaturedProject from '../components/home/FeaturedProject.astro';
import Clients from '../components/home/Clients.astro';
import Operations from '../components/home/Operations.astro';
import HowWeWork from '../components/home/HowWeWork.astro';
import Team from '../components/home/Team.astro';
import Contact from '../components/home/Contact.astro';
import { seo } from '../config/site';
---
<BaseLayout title={seo.home.title} description={seo.home.description} path={seo.home.path} headerOverlay>
      <Hero />

      <Problems />

      <Solutions />

      <FeaturedProject />

      <Clients />

      <Operations />

      <HowWeWork />

      <Team />

      <Contact />
</BaseLayout>
