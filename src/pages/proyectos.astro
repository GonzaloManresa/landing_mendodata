---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectsHero from '../components/projects/ProjectsHero.astro';
import ProjectCase from '../components/projects/ProjectCase.astro';
import ProjectsCta from '../components/projects/ProjectsCta.astro';
import { seo } from '../config/site';
import { featuredProject } from '../data/projects';
---
<BaseLayout title={seo.proyectos.title} description={seo.proyectos.description} path={seo.proyectos.path} current="/proyectos">
  <ProjectsHero />
  <ProjectCase project={featuredProject} />
  <!-- "Otros proyectos" se agrega cuando existan más casos reales documentados -->
  <ProjectsCta />
</BaseLayout>
