---
import ProjectVisual from '../home/ProjectVisual.astro';
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { detail } = project;

const featureIcons = ['barcode', 'swap', 'diff', 'check'] as const;
---
<section class="case" id={project.slug} aria-labelledby={`${project.slug}-title`}>
  <div class="case-inner">
    <header class="case-head">
      <p class="case-badge">{project.status}</p>
      <h2 id={`${project.slug}-title`}>{project.name}</h2>
      <p class="case-tags">{project.tags.join(' · ')}</p>
      <p class="case-summary">{detail.summary}</p>
    </header>

    <figure class="case-visual">
      <ProjectVisual label={project.visualAlt} id={detail.visualId} />
      <figcaption>
        <span>{project.visualNote}</span>
        <span>{project.privacyNote}</span>
      </figcaption>
    </figure>

    <div class="case-grid">
      <article class="case-card">
        <span class="case-icon blue" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 21V8l8-5 8 5v13" /><path d="M9 21v-6h6v6" />
          </svg>
        </span>
        <h3>Contexto</h3>
        <p>{detail.context}</p>
      </article>

      <article class="case-card">
        <span class="case-icon red" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10.3 4.2 2.8 17.5A2 2 0 0 0 4.5 20.5h15a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0z" /><path d="M12 9.5v4M12 17h.01" />
          </svg>
        </span>
        <h3>Problema</h3>
        <p>{detail.problem}</p>
      </article>

      <article class="case-card">
        <span class="case-icon blue" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 18h6M10 21h4" /><path d="M12 3a6 6 0 0 0-3.6 10.8c.6.5 1.1 1.3 1.1 2.2h5c0-.9.5-1.7 1.1-2.2A6 6 0 0 0 12 3z" />
          </svg>
        </span>
        <h3>Solución</h3>
        <p>{project.solution}</p>
      </article>
    </div>

    <div class="case-features">
      <h3>Funcionalidades principales</h3>
      <ul>
        {detail.features.map((feature, i) => (
          <li>
            <span class="case-icon blue small" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                {featureIcons[i] === 'barcode' && <path d="M4 5v14M7 5v14M11 5v14M14 5v14M17 5v14M20 5v14" />}
                {featureIcons[i] === 'swap' && <path d="M4 8h14l-3.5-3.5M20 16H6l3.5 3.5" />}
                {featureIcons[i] === 'diff' && <path d="M12 4v16M4 12h6M14 12h6M17 9v6" />}
                {featureIcons[i] === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
              </svg>
            </span>
            {feature}
          </li>
        ))}
      </ul>
    </div>

    <div class="case-result">
      <span class="case-icon green" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M6 20.5v-6M12 20.5v-10M18 20.5v-15" />
        </svg>
      </span>
      <div>
        <h3>Resultado</h3>
        <p>{detail.result}</p>
        <ul class="result-points">
          {detail.resultPoints.map((point) => <li>{point}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .case {
    padding: clamp(24px, 3vw, 40px) 22px clamp(64px, 8vw, 104px);
    background: var(--bg);
  }

  .case-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(28px, 4vw, 56px);
    border: 1px solid #E6EDF7;
    border-radius: 32px;
    background: #FFFFFF;
    box-shadow: 0 24px 64px rgba(11, 27, 63, 0.07);
  }

  .case-head {
    max-width: 780px;
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  .case-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    padding: 6px 14px;
    border: 1px solid #CFE0FB;
    border-radius: 999px;
    background: #EEF5FF;
    color: var(--accent-strong);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h2 {
    max-width: none;
    margin: 0 0 10px;
    color: var(--ink);
    font-size: clamp(1.9rem, 3.8vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .case-tags {
    margin: 0 0 14px;
    color: var(--ink-mute);
    font-weight: 600;
  }

  .case-summary {
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.6;
  }

  .case-visual {
    margin: 0 0 clamp(28px, 3vw, 40px);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 18px;
    margin-top: 10px;
    color: var(--ink-mute);
    font-size: 0.84rem;
    text-align: center;
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .case-card {
    padding: 24px;
    border: 1px solid #EAEFF6;
    border-radius: 20px;
    background: #FBFCFE;
  }

  .case-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 52px;
    height: 52px;
    margin-bottom: 14px;
    border-radius: 14px;
  }

  .case-icon.small {
    width: 40px;
    height: 40px;
    margin: 0;
    border-radius: 12px;
  }

  .case-icon.blue { background: #EAF3FE; color: var(--accent); }
  .case-icon.red { background: #FDECEF; color: #D92D55; }
  .case-icon.green { background: #E6F6EC; color: #1E8E4E; }

  h3 {
    margin: 0 0 8px;
    color: var(--ink);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .case-card p,
  .case-result p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.6;
  }

  .case-features {
    margin-top: 16px;
    padding: 24px;
    border: 1px solid #EAEFF6;
    border-radius: 20px;
    background: #FBFCFE;
  }

  .case-features h3 {
    margin-bottom: 16px;
  }

  .case-features ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-features li {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--ink);
    font-weight: 600;
  }

  .case-result {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    margin-top: 16px;
    padding: 24px;
    border-radius: 20px;
    background: #EEF5FF;
  }

  .case-result .case-icon {
    margin: 0;
  }

  .result-points {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .result-points li {
    padding: 6px 14px;
    border-radius: 999px;
    background: #FFFFFF;
    color: var(--accent-strong);
    font-size: 0.9rem;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .case-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .case {
      padding: 8px 12px 64px;
    }

    .case-inner {
      padding: 22px 16px;
      border-radius: 24px;
    }

    .case-features ul {
      grid-template-columns: minmax(0, 1fr);
    }

    .case-result {
      flex-direction: column;
    }
  }
</style>
