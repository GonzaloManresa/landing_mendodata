---
import WhatsAppIcon from '../WhatsAppIcon.astro';
import { contactHref, whatsappUrl } from '../../config/site';

const whatsappHref = whatsappUrl();
---
<section class="projects-cta" id="contacto-proyectos" aria-labelledby="contacto-proyectos-title">
  <div class="projects-cta-inner">
    <p class="cta-kicker">HABLEMOS</p>
    <h2 id="contacto-proyectos-title">¿Tenés un problema parecido o un proceso que <span class="hl">necesitás ordenar?</span></h2>
    <p class="cta-lead">Contanos brevemente qué está pasando en tu empresa. Primero entendemos la necesidad y después vemos qué solución tiene sentido.</p>
    <div class="cta-actions">
      <a class="cta-primary" href={contactHref}>
        Contanos qué necesitás resolver
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
      {whatsappHref && (
        <a class="cta-secondary" href={whatsappHref} target="_blank" rel="noopener">
          <WhatsAppIcon size={22} />
          Hablar por WhatsApp
        </a>
      )}
    </div>
  </div>
</section>

<style>
  /* Cierre claro antes del Footer navy */
  .projects-cta {
    padding: clamp(64px, 8vw, 104px) 22px;
    background: linear-gradient(180deg, var(--bg) 0%, #EEF5FF 100%);
    text-align: center;
  }

  .projects-cta-inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .cta-kicker {
    display: inline-block;
    margin: 0 0 18px;
    padding: 6px 14px;
    border-radius: 999px;
    background: #FFFFFF;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  h2 {
    max-width: 27ch;
    margin: 0 auto 18px;
    color: var(--ink);
    font-size: clamp(1.9rem, 3.8vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .hl {
    color: var(--accent);
  }

  .cta-lead {
    max-width: 56ch;
    margin: 0 auto 30px;
    color: var(--ink-soft);
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  .cta-primary,
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 56px;
    padding: 0 28px;
    border-radius: 999px;
    font-size: 1.04rem;
    font-weight: 700;
    transition: background 160ms ease;
  }

  .cta-primary {
    background: var(--accent);
    color: #FFFFFF;
    box-shadow: 0 12px 28px rgba(10, 108, 245, 0.24);
  }

  .cta-primary:hover {
    background: var(--accent-strong);
  }

  .cta-secondary {
    border: 2px solid var(--accent);
    background: #FFFFFF;
    color: var(--accent);
  }

  .cta-secondary:hover {
    background: #EEF5FF;
  }

  @media (max-width: 640px) {
    .projects-cta {
      padding: 56px 16px 96px;
    }

    .cta-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
