---
// Hero split 50/50: texto a la izquierda, foto del equipo a sangre a la derecha.
// H1 y bajada los definió el cliente después del lanzamiento.
// El mockup del dashboard (HeroVisual) y la franja de confianza (HeroTrust) salieron
// del Hero en este rediseño; los componentes se conservan en el repo.
---
<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title">
      <span class="line">Sistemas</span> <span class="line hl">a medida</span> <span class="line">para pymes</span>
    </h1>
    <p class="hero-lead">
      Ordenamos la información y automatizamos las tareas manuales de tu operación.
    </p>
    <div class="hero-actions">
      <a class="button accent hero-cta" href="#contacto">
        Contanos qué necesitás
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
      <a class="hero-link" href="#proyecto-destacado">Ver proyectos</a>
    </div>
  </div>

  <div class="hero-media">
    <!-- Foto pendiente: reemplazar este div por
         <img src="/img/equipo.jpg" alt="Equipo de MendoData" width="1600" height="1200"> -->
    <div class="hero-photo-placeholder" aria-hidden="true">[FOTO DEL EQUIPO]</div>

    <div class="hero-card">
      <!-- Cada círculo se puede reemplazar por <img src="..." alt=""> con la cara de cada integrante -->
      <div class="hero-avatars" aria-hidden="true">
        <span class="hero-avatar"></span>
        <span class="hero-avatar"></span>
        <span class="hero-avatar"></span>
      </div>
      <p class="hero-card-text">
        <strong>Primero entendemos tu operación.</strong>
        <span>Después elegimos la tecnología.</span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: min(100svh, 820px);
    background: var(--surface);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    container-type: inline-size;
    /* Arriba deja lugar al header superpuesto */
    padding: 128px 64px 64px;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-family: "Bricolage Grotesque", var(--font-display);
    /* Tope por ancho de columna: "para pymes" siempre entra en una línea */
    font-size: min(clamp(3rem, 7.5vw, 7rem), 18cqi);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  /* Una línea por bloque: Sistemas / a medida / para pymes */
  .line {
    display: block;
    white-space: nowrap;
  }

  .hl {
    color: #0A5BD3;
  }

  .hero-lead {
    max-width: 440px;
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }

  .hero-cta {
    min-height: 60px;
    padding: 0 30px 0 34px;
    gap: 14px;
    font-size: 1.1rem;
    box-shadow: 0 12px 28px rgba(10, 108, 245, 0.24);
    transition:
      background 160ms ease,
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .hero-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 16px 32px rgba(10, 108, 245, 0.3);
  }

  .hero-cta:active {
    transform: translateY(0);
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  .hero-link:hover {
    color: var(--accent);
  }

  .hero-media {
    position: relative;
    overflow: hidden;
    background: #DCE4F1;
  }

  .hero-media > img,
  .hero-photo-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-media > img {
    object-fit: cover;
  }

  .hero-photo-placeholder {
    display: grid;
    place-items: center;
    background: #DCE4F1;
    color: var(--ink-mute);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .hero-card {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 40px;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 24px;
    border-radius: 18px;
    background: var(--surface);
    box-shadow: 0 16px 40px rgba(11, 27, 63, 0.14);
  }

  .hero-avatars {
    display: flex;
    flex: 0 0 auto;
    padding-left: 12px;
  }

  .hero-avatar,
  .hero-avatars > img {
    width: 44px;
    height: 44px;
    margin-left: -12px;
    border: 3px solid var(--surface);
    border-radius: 50%;
    object-fit: cover;
  }

  .hero-avatar:nth-child(1) { background: #0B1B3F; }
  .hero-avatar:nth-child(2) { background: #0A5BD3; }
  .hero-avatar:nth-child(3) { background: #8FB6FF; }

  .hero-card-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    color: var(--ink);
    font-size: 0.98rem;
    line-height: 1.4;
  }

  .hero-card-text span {
    color: var(--ink-soft);
  }

  @media (max-width: 899px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    /* El header vuelve a ser normal: no hace falta dejarle lugar */
    .hero-copy {
      padding: 40px 22px 48px;
    }

    .hero-media {
      height: 420px;
    }
  }

  @media (max-width: 640px) {
    .hero-copy {
      padding: 32px 16px 40px;
    }

    .hero-cta {
      padding: 0 24px 0 26px;
      font-size: 1rem;
    }

    .hero-card {
      left: 16px;
      right: 16px;
      bottom: 16px;
      gap: 14px;
      padding: 16px 18px;
    }

    .hero-card-text {
      font-size: 0.92rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cta:hover,
    .hero-cta:active {
      transform: none;
    }
  }
</style>
