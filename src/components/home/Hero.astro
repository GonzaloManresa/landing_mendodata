---
import HeroVisual from './HeroVisual.astro';

// Hero split 50/50: texto a la izquierda, mockup del dashboard a la derecha.
// H1 y bajada los definió el cliente después del lanzamiento. El H1 combina Inter 800
// con "a medida" en Newsreader Italic, como acento de marca.
// La franja de confianza (HeroTrust) y la tarjeta "Primero entendemos…" (HeroCard)
// salieron del Hero; los componentes se conservan en el repo.
---
<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title">
      <span class="line">Sistemas</span> <span class="line hl">a medida</span> <span class="line">para pymes</span>
    </h1>
    <p class="hero-lead">
      Ordenamos la información y automatizamos las tareas manuales de tu operación.
    </p>
    <div class="hero-actions">
      <a class="button accent hero-cta" href="#contacto">
        Contanos qué necesitás
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
      <a class="hero-link" href="#proyecto-destacado">Ver proyectos</a>
    </div>
  </div>

  <div class="hero-media">
    <HeroVisual />

  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: min(100svh, 820px);
    background: var(--surface);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    container-type: inline-size;
    /* Arriba deja lugar al header superpuesto */
    padding: 128px 64px 64px;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    /* Tope por ancho de columna: "para pymes" siempre entra en una línea */
    font-size: min(clamp(3rem, 7.5vw, 7rem), 18cqi);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  /* Una línea por bloque: Sistemas / a medida / para pymes */
  .line {
    display: block;
    white-space: nowrap;
  }

  /* Acento de marca: Newsreader Italic. Su ojo es más chico que el de Inter,
     por eso va un poco más grande y con interlineado compensado. */
  .hl {
    color: #0A5BD3;
    font-family: var(--font-accent);
    font-size: 1.08em;
    font-style: italic;
    font-weight: 500;
    line-height: calc(0.9em / 1.08);
    letter-spacing: -0.01em;
    /* Su ojo bajo la deja visualmente pegada a "Sistemas": se baja un poco
       para que el aire entre las tres líneas se vea parejo */
    position: relative;
    top: 0.08em;
  }

  .hero-lead {
    max-width: 440px;
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }

  .hero-cta {
    min-height: 60px;
    padding: 0 30px 0 34px;
    gap: 14px;
    font-size: 1.1rem;
    box-shadow: 0 12px 28px rgba(10, 108, 245, 0.24);
    transition:
      background 160ms ease,
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .hero-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 16px 32px rgba(10, 108, 245, 0.3);
  }

  .hero-cta:active {
    transform: translateY(0);
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  .hero-link:hover {
    color: var(--accent);
  }

  .hero-media {
    position: relative;
    overflow: hidden;
    /* Grilla de puntos sutil */
    background:
      radial-gradient(circle, #C5D1E6 1.5px, transparent 1.6px) 0 0 / 24px 24px,
      #DCE4F1;
  }

  @media (max-width: 899px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    /* El header vuelve a ser normal: no hace falta dejarle lugar */
    .hero-copy {
      padding: 40px 22px 48px;
    }

    .hero-media {
      padding: 40px 22px;
    }
  }

  @media (max-width: 640px) {
    .hero-copy {
      padding: 32px 16px 40px;
    }

    .hero-cta {
      padding: 0 24px 0 26px;
      font-size: 1rem;
    }

    .hero-media {
      padding: 32px 16px;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cta:hover,
    .hero-cta:active {
      transform: none;
    }
  }
</style>
