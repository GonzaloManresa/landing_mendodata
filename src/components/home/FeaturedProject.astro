---
import ProjectVisual from './ProjectVisual.astro';
import { featuredProject as project } from '../../data/projects';

const blocks = [
  { key: 'problem', title: 'Problema', tone: 'red' },
  { key: 'solution', title: 'Solución', tone: 'blue' },
  { key: 'features', title: 'Funcionalidades', tone: 'blue' },
  { key: 'result', title: 'Resultado', tone: 'green' },
] as const;

// "Control de inventario y sucursales": la última palabra va en azul, como en el mockup
const nameLead = project.name.slice(0, project.name.lastIndexOf(' '));
const nameTail = project.name.slice(project.name.lastIndexOf(' ') + 1);
---
<section class="featured" id="proyecto-destacado" aria-labelledby="proyecto-destacado-title">
  <div class="featured-inner">
    <header class="featured-head">
      <h2 id="proyecto-destacado-title">Proyecto destacado</h2>
      <p class="featured-lead">Una solución construida alrededor de una necesidad operativa real.</p>
      <p class="featured-badge">{project.status}</p>
      <h3 class="featured-name">{nameLead} <span class="hl">{nameTail}</span></h3>
      <p class="featured-tags">{project.tags.join(' · ')}</p>
    </header>

    <div class="featured-grid">
      <figure class="featured-visual">
        <ProjectVisual label={project.visualAlt} />
        <figcaption>
          <span>{project.visualNote}</span>
          <span>{project.privacyNote}</span>
        </figcaption>
      </figure>

      <div class="featured-detail">
        {blocks.map((block) => (
          <div class="detail-card">
            <span class={`detail-icon ${block.tone}`} aria-hidden="true">
              <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                {block.key === 'problem' && (
                  <Fragment>
                    <path d="M10.3 4.2 2.8 17.5A2 2 0 0 0 4.5 20.5h15a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0z" />
                    <path d="M12 9.5v4M12 17h.01" />
                  </Fragment>
                )}
                {block.key === 'solution' && (
                  <Fragment>
                    <path d="M9 18h6M10 21h4" />
                    <path d="M12 3a6 6 0 0 0-3.6 10.8c.6.5 1.1 1.3 1.1 2.2h5c0-.9.5-1.7 1.1-2.2A6 6 0 0 0 12 3z" />
                  </Fragment>
                )}
                {block.key === 'features' && (
                  <Fragment>
                    <path d="M4 7h10M18 7h2M4 17h2M10 17h10" />
                    <circle cx="16" cy="7" r="2.2" />
                    <circle cx="8" cy="17" r="2.2" />
                  </Fragment>
                )}
                {block.key === 'result' && (
                  <path d="M6 20.5v-6M12 20.5v-10M18 20.5v-15" />
                )}
              </svg>
            </span>
            <div class="detail-text">
              <h4>{block.title}</h4>
              {block.key === 'features' ? (
                <ul class="features">
                  {project.features.map((feature) => <li class="feature">{feature}</li>)}
                </ul>
              ) : (
                <p>{project[block.key]}</p>
              )}
            </div>
          </div>
        ))}

        <div class="featured-actions">
          <a class="featured-cta" href="#contacto">
            ¿Tenés un desafío parecido? Contanos tu caso
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          <a class="featured-more" href="/proyectos">Ver proyectos</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .featured {
    position: relative;
    overflow: clip;
    padding: clamp(72px, 9vw, 120px) 22px;
    background: var(--surface);
  }

  .featured::before,
  .featured::after {
    content: "";
    position: absolute;
    z-index: 0;
    width: 50%;
    height: 80%;
    border-radius: 50%;
    pointer-events: none;
  }

  .featured::before {
    top: -30%;
    right: -22%;
    background: radial-gradient(closest-side, rgba(10, 108, 245, 0.12), transparent);
  }

  .featured::after {
    bottom: -32%;
    left: -26%;
    background: radial-gradient(closest-side, rgba(10, 108, 245, 0.1), transparent);
  }

  .featured-inner {
    position: relative;
    z-index: 1;
    max-width: 1340px;
    margin: 0 auto;
  }

  .featured-head {
    max-width: 1100px;
    margin: 0 auto clamp(36px, 4vw, 52px);
    text-align: center;
  }

  /* El H2 es el rótulo de la sección; el nombre del proyecto lleva el peso visual */
  h2 {
    max-width: none;
    margin: 0 0 12px;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .featured-lead {
    margin: 0 0 22px;
    color: var(--ink-soft);
    font-size: clamp(1.02rem, 1.4vw, 1.2rem);
  }

  .featured-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    padding: 6px 14px;
    border: 1px solid #CFE0FB;
    border-radius: 999px;
    background: #EEF5FF;
    color: var(--accent-strong);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .featured-badge::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .featured-name {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: clamp(2.1rem, 4.4vw, 3.8rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .hl {
    color: var(--accent);
  }

  .featured-tags {
    margin: 0;
    color: var(--ink-mute);
    font-size: 1rem;
    font-weight: 500;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 56fr) minmax(0, 44fr);
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
  }

  /* En desktop la laptop acompaña la lectura de las tarjetas */
  .featured-visual {
    position: sticky;
    top: 112px;
    margin: 0;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 18px;
    margin-top: 10px;
    color: var(--ink-mute);
    font-size: 0.82rem;
    text-align: center;
  }

  .featured-detail {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .detail-card {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 18px 22px;
    border: 1px solid #EAEFF6;
    border-radius: 20px;
    background: #FFFFFF;
    box-shadow: 0 12px 34px rgba(11, 27, 63, 0.06);
  }

  .detail-icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
  }

  .detail-icon.red { background: #FDECEF; color: #D92D55; }
  .detail-icon.blue { background: #EAF3FE; color: var(--accent); }
  .detail-icon.green { background: #E6F6EC; color: #1E8E4E; }

  h4 {
    margin: 2px 0 6px;
    color: var(--ink);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .detail-text p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.97rem;
    line-height: 1.55;
  }

  .features {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feature {
    position: relative;
    padding-left: 24px;
    color: var(--ink-soft);
    font-size: 0.97rem;
    line-height: 1.45;
  }

  .feature::before {
    content: "";
    position: absolute;
    top: 0.35em;
    left: 2px;
    width: 12px;
    height: 7px;
    border-bottom: 2px solid var(--accent);
    border-left: 2px solid var(--accent);
    transform: rotate(-45deg);
  }

  .featured-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 6px;
  }

  .featured-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    min-height: 60px;
    padding: 0 28px;
    border: 2px solid var(--accent);
    border-radius: 999px;
    background: #FFFFFF;
    color: var(--accent);
    font-size: 1.06rem;
    font-weight: 700;
    text-align: center;
    transition: background 160ms ease, color 160ms ease;
  }

  .featured-cta:hover {
    background: var(--accent);
    color: #FFFFFF;
  }

  .featured-cta:active {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
    color: #FFFFFF;
  }

  .featured-more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 8px;
    color: var(--ink-soft);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .featured-more::after {
    content: " →";
    white-space: pre;
  }

  .featured-more:hover {
    color: var(--accent);
  }

  @media (max-width: 1080px) {
    .featured-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .featured-visual {
      position: static;
      max-width: 820px;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .featured {
      padding: 64px 16px;
    }

    .detail-card {
      gap: 16px;
      padding: 18px;
    }

    .detail-icon {
      width: 48px;
      height: 48px;
    }

    .detail-icon svg {
      width: 24px;
      height: 24px;
    }

    .featured-cta {
      min-height: 56px;
      padding: 0 18px;
      font-size: 1rem;
    }
  }
</style>
