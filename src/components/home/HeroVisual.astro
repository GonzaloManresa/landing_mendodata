---
import LaptopFrame from '../LaptopFrame.astro';

// Visual del Hero: laptop con una captura del sistema de demo (empresa ficticia,
// datos de ejemplo) + celular dibujado en HTML/CSS. No es un proyecto real.
// Todo se mide en `em`; el tamaño base sale del ancho del contenedor,
// así la composición escala entera sin deformarse.

const kpis = [
  { label: 'Pedidos procesados', value: '2.847', delta: '+12%', up: true, icon: 'box' },
  { label: 'Tareas automatizadas', value: '436', delta: '+8%', up: true, icon: 'bolt' },
  { label: 'Pendientes de aprobación', value: '24', delta: '-20%', up: false, icon: 'doc' },
];

const areas = [
  { name: 'Compras', pct: 35 },
  { name: 'Ventas', pct: 28 },
  { name: 'Inventario', pct: 18 },
  { name: 'Administración', pct: 12 },
  { name: 'Otros', pct: 7 },
];

---
<div class="hero-visual" id="hero-visual">
  <p class="demo-badge">Demostración ilustrativa</p>

  <div class="stage" role="img" aria-label="Interfaz digital para organizar procesos operativos, información y datos empresariales.">
    <!-- Laptop -->
    <div class="laptop">
      <LaptopFrame>
        <!-- Pantalla real del sistema de demo (empresa ficticia, datos de ejemplo) -->
        <img class="screen screen-shot" src="/assets/hero-screen.webp" alt="" width="1600" height="863" decoding="async">
      </LaptopFrame>
    </div>

    <!-- Celular -->
    <div class="phone" aria-hidden="true">
      <div class="screen phone-screen">
        <div class="phone-notch"></div>
        <div class="phone-top">
          <div class="app-brand">
            <img src="/assets/mendodata-symbol.png" alt="" width="583" height="186">
            <span>MendoData</span>
          </div>
          <span class="burger"></span>
        </div>
        <div class="phone-title">
          <strong>Resumen</strong>
          <span class="app-select">Hoy</span>
        </div>
        {kpis.map((kpi) => (
          <div class="card kpi">
            <span class="kpi-label">{kpi.label}</span>
            <span class="kpi-value">{kpi.value}</span>
            <span class:list={['kpi-delta', { down: !kpi.up }]}>{kpi.up ? '↑' : '↓'} {kpi.delta}</span>
            <span class="kpi-icon"></span>
          </div>
        ))}
        <div class="card donut-card">
          <span class="card-title">Registros por área</span>
          <div class="donut-wrap">
            <div class="donut small"></div>
            <ul class="legend">
              {areas.map((area, i) => <li><i class={`c${i}`}></i>{area.name}<b>{area.pct}%</b></li>)}
            </ul>
          </div>
        </div>
        <div class="phone-nav">
          <span class="is-active"><i></i>Inicio</span>
          <span><i></i>Procesos</span>
          <span><i></i>Reportes</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Vive en la columna derecha del Hero split, que recorta con overflow: hidden.
     La laptop mide ~110% de la columna y se corta contra el borde de la pantalla. */
  .hero-visual {
    position: absolute;
    inset: 0;
    container-type: size;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 12px;
    /* Arriba deja lugar al header superpuesto */
    padding: 96px 0 24px;
  }

  .demo-badge {
    position: relative;
    z-index: 3;
    margin: 0 0 0 32px;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink-soft);
    font-size: 12px;
    font-weight: 600;
  }

  /* La escena mide 72em × 52em: laptop de 62em a la derecha y el celular
     asomando a la izquierda. 1em sale del ancho (laptop = 110% de la columna),
     con tope por alto para que entre entera en el Hero. */
  .stage {
    position: relative;
    flex: 0 0 auto;
    font-size: min(calc(110cqw / 62), calc((100cqh - 48px) / 52));
    width: 72em;
    height: 52em;
    /* La laptop arranca a 10em del borde de la escena: así queda a 32px de la columna */
    margin-left: calc(32px - 10em);
    color: #1B2A4A;
    font-family: var(--font-body);
    line-height: 1.25;
  }

  .stage ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Laptop ----------------------------------------------------------- */
  .laptop {
    position: absolute;
    top: 3em;
    right: 0;
    width: 62em;
    filter: drop-shadow(0 2.4em 3em rgba(11, 27, 63, 0.16));
  }

  .screen {
    overflow: hidden;
    background: #F4F7FC;
  }

  /* La pantalla toma la proporción de la captura (1600 × 863) para no recortarla */
  .screen-shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1600 / 863;
    border-radius: 0.5em;
  }

  .app-brand {
    display: flex;
    align-items: center;
    gap: 0.45em;
    margin-bottom: 1.6em;
    font-size: 1em;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .app-brand img {
    width: 2.2em;
    height: auto;
  }

  .app-select {
    padding: 0.35em 0.8em;
    border: 1px solid #E1E7F0;
    border-radius: 0.5em;
    background: #FFFFFF;
    color: #54627C;
    font-size: 0.72em;
  }

  .card {
    position: relative;
    padding: 0.9em 1em;
    border: 1px solid #E6ECF5;
    border-radius: 0.8em;
    background: #FFFFFF;
    box-shadow: 0 0.2em 0.6em rgba(11, 27, 63, 0.04);
  }

  .card-title {
    display: block;
    color: var(--ink);
    font-size: 0.82em;
    font-weight: 700;
  }

  .kpi {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }

  .kpi-label {
    color: #6B7A93;
    font-size: 0.68em;
  }

  .kpi-value {
    color: var(--ink);
    font-size: 1.55em;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .kpi-delta {
    color: #1E8E4E;
    font-size: 0.66em;
    font-weight: 700;
  }

  .kpi-delta.down {
    color: #D23C3C;
  }

  .kpi-icon {
    position: absolute;
    top: 0.9em;
    right: 0.9em;
    width: 2.2em;
    height: 2.2em;
    border-radius: 0.6em;
    background: #E8F1FE;
  }

  .kpi-icon::after {
    content: "";
    position: absolute;
    inset: 0.62em;
    border: 0.15em solid var(--accent);
    border-radius: 0.28em;
  }

  .donut-wrap {
    display: flex;
    align-items: center;
    gap: 1.2em;
    margin-top: 0.8em;
  }

  .donut {
    position: relative;
    flex: 0 0 auto;
    width: 8.4em;
    height: 8.4em;
    border-radius: 50%;
    background: conic-gradient(
      #0A4FB8 0 35%,
      var(--accent) 35% 63%,
      #4F9BF8 63% 81%,
      #8FC0FB 81% 93%,
      #CFE2FD 93% 100%
    );
  }

  .donut::after {
    content: "";
    position: absolute;
    inset: 1.5em;
    border-radius: 50%;
    background: #FFFFFF;
  }

  .donut.small {
    width: 6em;
    height: 6em;
  }

  .donut.small::after {
    inset: 1.1em;
  }

  .legend {
    display: grid;
    flex: 1;
    gap: 0.45em;
    min-width: 0;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: #54627C;
    font-size: 0.62em;
  }

  .legend b {
    margin-left: auto;
    color: var(--ink);
    font-weight: 600;
  }

  .legend i {
    width: 0.75em;
    height: 0.75em;
    border-radius: 50%;
  }

  .legend .c0 { background: #0A4FB8; }
  .legend .c1 { background: var(--accent); }
  .legend .c2 { background: #4F9BF8; }
  .legend .c3 { background: #8FC0FB; }
  .legend .c4 { background: #CFE2FD; }

  /* Celular ---------------------------------------------------------- */
  .phone {
    position: absolute;
    left: 6em;
    bottom: 0;
    z-index: 2;
    width: 19.5em;
    padding: 0.8em;
    border-radius: 3.2em;
    background: #16181D;
    box-shadow:
      0 0 0 0.2em #3A3D45,
      0 2.4em 3.6em rgba(11, 27, 63, 0.24);
  }

  .phone-screen {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.8em;
    height: 40em;
    padding: 2.6em 1.1em 0;
    border-radius: 2.5em;
    background: #F7F9FD;
  }

  .phone-notch {
    position: absolute;
    top: 0.7em;
    left: 50%;
    width: 6.5em;
    height: 1.4em;
    border-radius: 1em;
    background: #16181D;
    transform: translateX(-50%);
  }

  .phone-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .phone-top .app-brand {
    margin: 0;
    font-size: 0.9em;
  }

  .burger {
    width: 1.2em;
    height: 0.9em;
    border-top: 0.15em solid var(--ink);
    border-bottom: 0.15em solid var(--ink);
    background: linear-gradient(var(--ink), var(--ink)) center / 100% 0.15em no-repeat;
  }

  .phone-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.4em;
  }

  .phone-title strong {
    color: var(--ink);
    font-size: 1.15em;
    font-weight: 700;
  }

  .phone .kpi {
    padding: 0.8em 0.9em;
  }

  .phone .kpi-value {
    font-size: 1.35em;
  }

  .phone .donut-wrap {
    gap: 0.9em;
    margin-top: 0.6em;
  }

  .phone-nav {
    display: flex;
    justify-content: space-around;
    margin: auto -1.1em 0;
    padding: 0.8em 0 1.3em;
    border-top: 1px solid #E6ECF5;
    background: #FFFFFF;
  }

  .phone-nav span {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3em;
    color: #6B7A93;
    font-size: 0.56em;
  }

  .phone-nav i {
    width: 1.7em;
    height: 1.7em;
    border: 0.25em solid currentColor;
    border-radius: 0.45em;
  }

  .phone-nav .is-active {
    color: var(--accent);
  }

  /* Tablet: el Hero pasa a una columna y el visual va centrado ------- */
  /* Una columna: el mockup va debajo del texto, entero y centrado */
  @media (max-width: 899px) {
    .hero-visual {
      position: relative;
      inset: auto;
      container-type: inline-size;
      align-items: center;
      padding: 0;
    }

    .demo-badge {
      margin: 0;
    }

    /* 75em de ancho útil: la base de la laptop sobresale 3em de la escena */
    .stage {
      font-size: calc(100cqw / 75);
      margin-left: 0;
    }

    .phone {
      left: 0;
    }
  }

  /* Mobile: el celular no entra legible junto a la laptop; queda solo la laptop */
  @media (max-width: 640px) {
    .stage {
      font-size: calc(100cqw / 68);
      width: 62em;
      /* Laptop sola: pantalla de 32em + marco y base */
      height: 39.6em;
    }

    .phone {
      display: none;
    }
  }
</style>
