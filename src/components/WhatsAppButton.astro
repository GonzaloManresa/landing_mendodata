---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappUrl } from '../config/site';

const href = whatsappUrl();
---
{href && (
  <a class="whatsapp-float" href={href} target="_blank" rel="noopener" aria-label="Contactar a MendoData por WhatsApp">
    <WhatsAppIcon size={28} />
  </a>
)}

<style>
  .whatsapp-float {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 15;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: #187A42;
    color: #ffffff;
    box-shadow: 0 8px 24px rgba(20, 41, 61, 0.22);
    transition: transform 160ms ease, background 160ms ease;
  }

  .whatsapp-float:hover {
    background: #14683A;
    transform: translateY(-2px);
  }

  .whatsapp-float:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 2px;
    box-shadow: 0 0 0 5px var(--ink), 0 8px 24px rgba(20, 41, 61, 0.22);
  }

  @media (max-width: 640px) {
    .whatsapp-float {
      right: max(16px, env(safe-area-inset-right));
      bottom: max(16px, env(safe-area-inset-bottom));
    }
  }
</style>
